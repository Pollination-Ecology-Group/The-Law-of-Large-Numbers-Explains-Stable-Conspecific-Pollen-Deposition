@article{Oborny1995,
abstract = {The hierarchical (genet-ramet) organization of clonal plants offers a variety of strategies in life history, resource use and space occupation that are specific to clonality. The authors present examples for particular clonal traits and their community level effects, as they appear from field studies and theoretical models. These examples suggest that clonality imposes strong constraints on spatial pattern and competitive relations in plant communities. However, clonality can also release constraints of species coexistence related to a trade-off between mobility and local persistence.},
