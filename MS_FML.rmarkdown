# Combine
(p_cv + p_cv_year) / (p_mean_comp + p_mean_year) +
    plot_layout(guides = "collect") &
    theme(legend.position = "top") &
    plot_annotation(title = "Variability and Means of Pollen Counts")
```

19, p=0.663). Instead, variance during this single season was heavily driven by differences among individual plants (χ2=126.53, p\<0.001), suggesting \#### Variance Partitioning

Variance partitioning and subsequent likelihood ratio tests revealed significant temporal and spatial drivers of heterospecific pollen (HP) deposition. At the inter-annual scale (2022-2024), we found significant variation in HP deposition driven by both the sampling year (χ2=32.39, p\<0.001) and the individual plant nested within year (χ2=104.73, p\<0.001).

However, fine-scale intra-annual analysis of the 2024 season showed that daily temporal variation was not a significant driver of HP deposition (χ2=0.19, p=0.663). Instead, variance during this single season was heavily driven by differences among individual plants (χ2=126.53, p\<0.001), suggesting that plant-level traits or highly localized micro-spatial effects dictate heterospecific pollen transfer more than daily phenological shifts.

### The Hierarchical Scale of Total Pollen Depositional Variance

```{r}
#| label: analysis-variance-partitioning
#| echo: false
#| warning: false
#| message: false
#| fig-cap: "Pollen Deposition Model and Variance Partitioning. A) Model depicting Heterospecific vs Conspecific Pollen deposition. The dashed gray line represents the 1:1 expected relationship. B) Hierarchical Variance Partitioning of pollen deposited on stigmas."
#| fig-height: 10
# 1. Data Preparation
vca_data <- pollen_deposition %>%
    filter(!is.na(heterospecific_pollen) & !is.na(conspecific_pollen)) %>%
    mutate(
        # Response Variables
        sqrt_HP = sqrt(heterospecific_pollen),
        sqrt_CP = sqrt(conspecific_pollen),

        # Calculate Proportion HP (approximate normality with sqrt)
        total = heterospecific_pollen + conspecific_pollen,
        prop = ifelse(total > 0, heterospecific_pollen / total, 0),
        sqrt_Prop = sqrt(prop),

        # Factors
        year_fac = as.factor(year),
        date_fac = as.factor(paste(year, day, sep = "_")),
        plant_id = inflorescence_id # unique within year
    )

# 2. General Function for Two-Part VCA
run_twopart_vca <- function(data, variable_col, metric_label) {
    # Internal helper to extract variance
    extract_lmer_var <- function(model, name) {
        vc <- VarCorr(model)
        df <- as.data.frame(vc)

        # Ensure Residual is included
        if (!("Residual" %in% df$grp)) {
            sigma_sq <- attr(vc, "sc")^2
            df <- rbind(df, data.frame(grp = "Residual", var1 = NA, var2 = NA, vcov = sigma_sq, sdcor = attr(vc, "sc")))
        }

        # Calculate Percent
        total_var <- sum(df$vcov)
        df$percent <- (df$vcov / total_var) * 100
        df$Part <- name
        df$level <- dplyr::case_when(
            grepl("inflorescence", df$grp) ~ "Plant",
            grepl("plant_id", df$grp) ~ "Plant",
            df$grp == "year_fac" ~ "Year",
            df$grp == "date_fac" ~ "Date",
            df$grp == "Residual" ~ "Stigma",
            TRUE ~ "Other"
        )
        return(df[, c("Part", "level", "vcov", "sdcor", "percent")])
    }

    # Part 1: Inter-Annual (Global)
    f_inter <- as.formula(paste(variable_col, "~ 1 + (1 | year_fac / plant_id)"))
    m_inter <- lmer(f_inter, data = data)
    res_inter <- extract_lmer_var(m_inter, "Inter-Annual")

    # Part 2: Intra-Annual (2024 Only)
    data_24 <- filter(data, year == 2024)
    # Check if we have date variation in 2024
    f_intra <- as.formula(paste(variable_col, "~ 1 + (1 | date_fac / plant_id)"))
    m_intra <- lmer(f_intra, data = data_24)
    res_intra <- extract_lmer_var(m_intra, "Intra-Annual (2024 only)")

    # Combine
    combined <- rbind(res_inter, res_intra)
    combined$Metric <- metric_label
    return(combined)
}

# 3. Run for all 2 metrics (using Sqrt as validated in Supplement)
res_HP <- run_twopart_vca(vca_data, "sqrt_HP", "Heterospecific pollen")
res_CP <- run_twopart_vca(vca_data, "sqrt_CP", "Conspecific pollen")

all_results <- rbind(res_HP, res_CP)

# Define factor levels
all_results$level <- factor(all_results$level, levels = c("Year", "Date", "Plant", "Stigma"))
all_results$Metric <- factor(all_results$Metric, levels = c("Heterospecific pollen", "Conspecific pollen"))

# 4. Visualization (Percent only)
p_var <- ggplot(all_results, aes(x = Metric, y = percent, fill = level)) +
    geom_bar(stat = "identity", width = 0.6) +
    facet_wrap(~Part) +
    scale_x_discrete(labels = function(x) stringr::str_wrap(x, width = 15)) +
    scale_fill_brewer(palette = "Set2") +
    geom_text(aes(label = ifelse(percent > 1.5, paste0(round(percent, 0), "%"), "")),
        position = position_stack(vjust = 0.5),
        size = 4,
        fontface = "bold",
        color = "black"
    ) +
    labs(
        title = "Variance Partitioning (Transformed Data) of pollen deposited on stigmas",
        y = "% of Total Variance",
        x = "",
        fill = "Variance Source"
    ) +
    theme_classic() +
    theme(
        axis.text.x = element_text(face = "bold", angle = 0, hjust = 0.5, size = 11),
        strip.text = element_text(size = 12, face = "bold"),
        legend.position = "bottom"
    )

# Combine with the model plot from earlier chunk
p_combined_fig <- p_model / p_var +
    plot_annotation(tag_levels = "A") +
    plot_layout(heights = c(1, 1))

print(p_combined_fig)

# Detailed Variance Component Tables for CP and HP have been moved to Supplementary Material (Tables S9 and S10).
```

### Monte Carlo Simulation: The Interannual Variance Filter

The year-by-year Monte Carlo simulation confirmed that visitation redundancy effectively neutralizes micro-scale stochasticity for conspecific pollen (CP) across all measured years in the TPD. Regardless of the study year, the random additive accumulation of SVD from the global vector pool successfully recreated the stable mean CP loads observed in the field (e.g., 2024 Simulated CP Mean: 26.8; Observed CP Mean: 27.4). While the two-sample K-S tests flagged mathematical divergences (p\<0.001) due to the hypersensitivity of a 10,000-iteration model to biological saturation limits, the tight convergence of the central tendencies and the functional overlap of the distributions (D-statistics ranging from 0.103 to 0.166) demonstrate that visitation frequency alone acts as a robust mathematical filter, effectively translating single-visit variance into stable CP deposition.

Conversely, for heterospecific pollen (HP), the simulation’s accuracy varied sharply between years, revealing that HP accumulation is governed by environmental context rather than simple mechanical redundancy. If generalist vectors deposit mixed pollen loads based strictly on their baseline single-visit profiles, the null model dictates that stigmas should accumulate a low, normalized baseline load of HP (3.4 to 4.5 grains). In standard-density years (2022 and 2023), empirical stigmas accumulated HP loads that exceeded this mathematical expectation by more than tenfold (e.g., 2023 Observed HP: 50.4 vs. Simulated: 3.4), resulting in severe structural divergence from the null model (D\>0.77). Crucially, during the increased density of *S. pratensis* in 2024, this neighborhood-driven accumulation declined. The observed HP dropped to 9.6 grains, forcing the empirical distribution significantly closer to the mechanical baseline (D=0.265). Because vector mechanical efficiency was held constant in our simulation, this interannual shift confirms that while standard-density years suffer heavy reproductive interference from shared networks, the increased conspecific floral abundance in 2024 actively mitigated HP accumulation, suppressing it back toward the mechanical minimum.

```{r}
#| label: analysis-monte-carlo-svd
#| echo: false
#| warning: false
#| message: false
#| fig-cap: "Monte Carlo Simulation: SVD Averaging. A, B) Global comparisons. C-H) Yearly comparisons. Densities compare observed final stigma pollen loads and the expected distribution if stigmas accumulate randomized single visits."
#| fig-width: 12
#| fig-height: 12
library(dplyr)
library(ggplot2)
if (!requireNamespace("patchwork", quietly = TRUE)) install.packages("patchwork")
library(patchwork)

set.seed(42)
n_simulations <- 10000

# 1. Establish the Global SVD Pool
svd_CP_global <- SVD_Succisa_22_24$conspecific_pollen[!is.na(SVD_Succisa_22_24$conspecific_pollen)]
svd_HP_global <- SVD_Succisa_22_24$heterospecific_pollen[!is.na(SVD_Succisa_22_24$heterospecific_pollen)]

# Global Stigmas
emp_CP_global <- pollen_deposition$conspecific_pollen[!is.na(pollen_deposition$conspecific_pollen)]
emp_HP_global <- pollen_deposition$heterospecific_pollen[!is.na(pollen_deposition$heterospecific_pollen)]

n_vis_global <- max(1, round(mean(emp_CP_global) / mean(svd_CP_global)))

make_mc_plot <- function(emp, svd_pool, n_vis, title_text, col_obs) {
    sim <- replicate(n_simulations, sum(sample(svd_pool, size = n_vis, replace = TRUE)))

    # Compute statistics
    ks_res <- ks.test(emp, sim)
    ov_res <- overlapping::overlap(list(emp, sim))

    annot_text <- sprintf("Overlap: %.1f%%\nKS D = %.3f", ov_res$OV * 100, ks_res$statistic)

    df <- data.frame(
        Value = c(emp, sim),
        Type = factor(
            c(rep("Observed Final Stigma", length(emp)), rep("Simulated (Averaged SVDs)", length(sim))),
            levels = c("Observed Final Stigma", "Simulated (Averaged SVDs)")
        )
    )

    max_x_val <- as.numeric(quantile(df$Value, 0.98))

    p <- ggplot(df, aes(x = Value, fill = Type)) +
        geom_density(alpha = 0.6, color = "white", linewidth = 0.2) +
        coord_cartesian(xlim = c(0, max_x_val)) +
        theme_classic() +
        labs(title = title_text, subtitle = annot_text, x = "Pollen Count", y = "Density") +
        scale_fill_manual(values = c("Observed Final Stigma" = col_obs, "Simulated (Averaged SVDs)" = "grey50")) +
        theme(
            plot.title = element_text(face = "bold", size = 11),
            plot.subtitle = element_text(size = 9, color = "gray20"),
            legend.position = "none"
        )
    return(p)
}

# Colors
col_global <- "#1ABC9C"
if (!requireNamespace("viridisLite", quietly = TRUE)) install.packages("viridisLite")
viridis_cols <- viridisLite::viridis(3, begin = 0.2, end = 0.8, option = "D")

inner_legend <- theme(
    legend.position = c(1, 1),
    legend.justification = c(1, 1),
    legend.title = element_blank(),
    legend.background = element_rect(fill = alpha("white", 0.7), color = NA),
    legend.key = element_rect(fill = "transparent")
)

# Row 1: Global
pA <- make_mc_plot(emp_CP_global, svd_CP_global, n_vis_global, "A. Global Conspecific Pollen", col_global)
pB <- make_mc_plot(emp_HP_global, svd_HP_global, n_vis_global, "B. Global Heterospecific Pollen", col_global) + inner_legend

# Row 2: 2022
emp_CP_22 <- pollen_deposition$conspecific_pollen[pollen_deposition$year == 2022]
emp_CP_22 <- emp_CP_22[!is.na(emp_CP_22)]
emp_HP_22 <- pollen_deposition$heterospecific_pollen[pollen_deposition$year == 2022]
emp_HP_22 <- emp_HP_22[!is.na(emp_HP_22)]

n_vis_22 <- max(1, round(mean(emp_CP_22) / mean(svd_CP_global)))
pC <- make_mc_plot(emp_CP_22, svd_CP_global, n_vis_22, "C. 2022 Conspecific Pollen", viridis_cols[1])
pD <- make_mc_plot(emp_HP_22, svd_HP_global, n_vis_22, "D. 2022 Heterospecific Pollen", viridis_cols[1]) + inner_legend

# Row 3: 2023
emp_CP_23 <- pollen_deposition$conspecific_pollen[pollen_deposition$year == 2023]
emp_CP_23 <- emp_CP_23[!is.na(emp_CP_23)]
emp_HP_23 <- pollen_deposition$heterospecific_pollen[pollen_deposition$year == 2023]
emp_HP_23 <- emp_HP_23[!is.na(emp_HP_23)]

n_vis_23 <- max(1, round(mean(emp_CP_23) / mean(svd_CP_global)))
pE <- make_mc_plot(emp_CP_23, svd_CP_global, n_vis_23, "E. 2023 Conspecific Pollen", viridis_cols[2])
pF <- make_mc_plot(emp_HP_23, svd_HP_global, n_vis_23, "F. 2023 Heterospecific Pollen", viridis_cols[2]) + inner_legend

# Row 4: 2024
emp_CP_24 <- pollen_deposition$conspecific_pollen[pollen_deposition$year == 2024]
emp_CP_24 <- emp_CP_24[!is.na(emp_CP_24)]
emp_HP_24 <- pollen_deposition$heterospecific_pollen[pollen_deposition$year == 2024]
emp_HP_24 <- emp_HP_24[!is.na(emp_HP_24)]

n_vis_24 <- max(1, round(mean(emp_CP_24) / mean(svd_CP_global)))
pG <- make_mc_plot(emp_CP_24, svd_CP_global, n_vis_24, "G. 2024 Conspecific Pollen", viridis_cols[3])
pH <- make_mc_plot(emp_HP_24, svd_HP_global, n_vis_24, "H. 2024 Heterospecific Pollen", viridis_cols[3]) + inner_legend

p_combined_mc <- (pA + pB) / (pC + pD) / (pE + pF) / (pG + pH)
print(p_combined_mc)
```

## Discussion

Generalist pollination systems are characterized by extreme micro-scaleosition stochasticity, yet population-level pollen dep often remains remarkably stable. Resolving how plants buffer against highly variable, mixed pollen loads delivered by shared vectors remains a central challenge in pollination ecology. Our analysis of *Succisa pratensis* pollen transfer and deposition patterns in 3 years resolves this paradox by demonstrating that stable pollen deposition does not require specialized vectors. Instead, the plant relies on overwhelming visitation redundancy, which mitigates conspecific depositional variance, while extreme local floral density acts as a filter, actively mitigating the accumulation of heterospecific pollen from the co-flowering community.

Here we discuss possible drivers of the CP deposition stability and HP deposition mitigation and consequences for *S. pratensis* pollen transfer and reproduction.

### SVD

The necessity of this spatial density filter is further underscored by the functional equivalence of the pollinator assemblage. Our single-visit deposition (SVD) analysis revealed no significant differences in conspecific or heterospecific pollen transfer across the dominant vector taxa; a single visit from a morphologically specialized *Bombus* was functionally indistinguishable from a visit by a generalized *Eristalis* syrphid fly. Because the plant cannot rely on pollinator constancy or morphological specialization to filter out environmental noise at the single-visit level, reproductive success is dictated entirely by interaction frequency.

This aligns perfectly with the concept of pollinator importance (Vázquez et al., 2005). Previous empirical studies have demonstrated that taxa with low or highly variable per-visit efficiency can dominate total pollen transfer simply through overwhelming visitation frequency (e.g., Sahli and Conner, 2007). In our system, the hyper-abundant *Eristalis* guild drives the pollination economy. While these generalist flies introduce substantial micro-scale stochasticity, their overwhelming visitation redundancy mathematically guarantees conspecific stability. By deploying extreme local floral density to mitigate the associated heterospecific carryover, *S. pratensis* safely leverages the massive visitation volume of the most abundant—albeit individually unpredictable—insects in the network.

#### Pollen transfer - from stochasticity to stability

Securing reliable pollen receipt within a diverse, generalist plant-pollinator community requires plants to overcome profound micro-scale stochasticity. As outlined by Richards et al. (2009), single-visit deposition is inherently variable, forcing plants to rely on broader ecological mechanisms to aggregate these individual events into stable reproductive outcomes. **Our variance partitioning analysis empirically validates this premise: temporal phenology (years and days) explained negligible variation in conspecific pollen (CP) receipt. Instead, the vast majority of depositional variance was driven entirely by micro-scale interactions at the individual plant and stigma level.** \>
Our Monte Carlo simulation successfully isolates the mechanism by which plants overcome this micro-scale variance: the statistical law of large numbers. By demonstrating that the random aggregation of highly variable single visits naturally produces the stable CP loads observed in the field, we confirm that *Succisa pratensis* successfully extracts stable pollination services from generalist vectors. Extreme visitation redundancy acts as a macro-scale filter, effectively neutralizing the intense micro-scale depositional variance of individual syrphid flies and bees.

The Narrative: Discuss how the mechanical transfer of pollen (SVD) is inherently messy. However, your Monte Carlo simulation proves mathematically that the plant doesn't need SVDs to be neat. It relies on the statistical "Law of Large Numbers." As long as the plant receives enough visits, the high variance is mathematically forced to average out into a stable mean.

The Literature Tie-in: Cite Vázquez et al. (2005) here to confirm that interaction frequency (redundancy) is the ultimate driver of pollination success, easily overriding the unpredictability of single-visit events (SVDs) highlighted by King et al. (2013).

The Caveat: Mention the slight discrepancy between the Monte Carlo simulation and reality (the taller peak). Explain this biologically: mathematical models assume perfect additivity, but real stigmas have physical saturation limits (clogging) and real flowers experience unequal visitation.

Paragraph 3: Volume Defeats Messiness (The Vector Economy)

The Goal: Explain the Eristalis vs. Bombus finding.

The Narrative: Challenge the traditional assumption that "messy" pollinators (bringing high HP) are detrimental. Your data proves that while Bombus is a "clean" pollinator, its low visitation rate makes it ecologically less important. Eristalis introduces the most HP, but its overwhelming visitation frequency floods the stigma with so much CP that the HP is rendered negligible.

The Literature Tie-in: This is the perfect place to cite Sahli & Conner (2007), who found the exact same thing with syrphid flies driving the pollen economy of wild radish purely through volume, despite poor single-visit efficiency.

Paragraph 4: The Shield of Floral Density (The 2024 Anomaly)

The Goal: Interpret the "Slope Showdown" and the failure of the Monte Carlo HP simulation.

The Narrative: Explain why the Monte Carlo simulation failed to predict HP (the plant dodged the expected HP load). Then, use the 2024 data to explain how it dodged it. In standard years, generalist pollinators are pulled by the "neighborhood effect," bringing linear HP accumulation. But in 2024, the massive spike in Succisa floral abundance completely overrode the neighborhood. The plant became so locally dominant that it essentially neutralized the ability of heterospecific neighbors to alter pollinator fidelity.

The Literature Tie-in: Cite Ye et al. (2020) for the "neighborhood effect" (how neighbors alter pollinator fidelity) and Arceo-Gómez et al. (2016) for the dilution effect of high conspecific density.

Paragraph 5: The Temporal Engine (The "Fresh Coat of Paint")

The Goal: Interpret the Body Load Purity (83.1% CP).

While our simulation models demonstrated that high visitation rates guarantee stable conspecific pollen delivery, mathematical redundancy alone cannot explain how S. pratensis avoids heterospecific pollen. If generalist vectors continuously deposit mixed pollen loads, heterospecific pollen should accumulate linearly alongside conspecific pollen as a function of total visits. Our multi-year accumulation analysis confirmed this baseline expectation during standard-density years (2022 and 2023), where conspecific pollen receipt reliably predicted heterospecific accumulation. However, during the pronounced high-density anomaly of 2024, this depositional relationship was fundamentally decoupled. Despite stigmas accumulating massive volumes of conspecific pollen, the heterospecific accumulation curve flattened entirely. This decoupling provides direct empirical evidence that high local floral abundance acts as a structural density shield. By aggressively diluting the proportion of heterospecific pollen within the local environmental pool, the density spike allowed the plant to extract the required visitation volume from dominant generalist vectors—such as Eristalis spp.—without paying the anticipated cost of reproductive interference.visitation redundancy work.

The Literature Tie-in: Cite your own work (Štenc et al., 2023) for the diurnal pollen release, and Brosi (2016) for how temporal specialization by generalist pollinators increases floral fidelity.

Paragraph 6: Conclusion and Broader Impacts

The Goal: Wrap it up with a strong takeaway for conservation or future network studies.

The Narrative: Conclude that generalized pollination networks are not "suboptimal" fallback strategies, but highly robust, multi-scale systems. Furthermore, point out that maintaining stable pollination services requires more than just saving the bees; it requires maintaining high, dense populations of the plants themselves. If plant populations thin out, they lose their "density shield," exposing them to reproductive interference even if the pollinator network remains perfectly intact.

Our results suggest that the relationship between conspecific and heterospecific pollen deposition is driven by specific functional mechanisms rather than simple abundance.

Our Monte Carlo simulation proved that high visitation rates are sufficient to explain how Succisa pratensis secures a stable, reliable load of conspecific pollen (CP). The simple mathematical averaging of multiple, highly variable single visits naturally produced the stable CP loads we observed in the field.

However, simple visitation redundancy cannot explain the patterns of heterospecific pollen (HP) deposition. If insects were simply depositing random mixtures of pollen at a constant rate, our simulation showed that every flower should receive a moderate, unavoidable dose of HP. Instead, observed stigmas overwhelmingly avoided HP entirely, peaking near zero. This disconnect between the simulation and reality proves that S. pratensis actively filters out HP using broader ecological strategies. By relying on dense local floral displays to dilute environmental HP, and utilizing early-morning pollen release to ensure insects are loaded with CP before visiting other species, the plant successfully overrides the expected accumulation of heterospecific noise. The few observed flowers that did receive massive HP loads likely represent rare events where a pollinator exhibited extreme flower inconstancy, switching directly from a neighboring heterospecific plant.

Our finding that Eristalis spp. drives the pollen economy despite introducing the most heterospecific noise perfectly aligns with the concept of 'pollinator importance' (Vázquez et al., 2005). Previous empirical studies have similarly demonstrated that taxa with low per-visit efficiency can dominate total pollen transfer simply through overwhelming visitation frequency. For example, Sahli and Conner (2007) found that while syrphid flies deposited minimal pollen during single visits, their exceptionally high visitation rates made them the most important contributors to total pollination. Likewise, our data proves that for Succisa pratensis, the sheer volume of generalist visits acts as a macro-scale filter, effectively drowning out the micro-scale 'messiness' of individual vectors.

"However, simple mathematical redundancy cannot explain the plant’s heterospecific pollen (HP) dynamics. If generalist insects were simply depositing random, mixed loads at a constant rate, our simulation proved that every flower should receive a relatively low, unavoidable baseline dose of HP. In standard years (2022 and 2023), empirical HP accumulation exceeded this baseline tenfold, proving that when conspecific density is standard, the co-flowering neighborhood actively pulls generalists away, resulting in heavily contaminated loads. Yet, during the 2024 high-density anomaly, empirical HP deposition crashed. The high local floral abundance acted as a structural shield, overriding the neighborhood effect and forcing HP accumulation down toward the baseline mechanical minimum. This demonstrates that generalized networks are robust, provided the focal plant maintains sufficient local density to dilute environmental HP and enforce vector fidelity

https://nph.onlinelibrary.wiley.com/doi/full/10.1111/nph.15868 - pollen competition - zahrát tuhle linku 

## Data Availability

The datasets used in this study are available in the supplementary material and have been exported for archiving.

```{r}
#| label: export-publication-data
#| echo: false
#| eval: true
#| message: false
#| warning: false
# --- 1. Define Metadata (Data Dictionary) ---

data_dictionary <- data.frame(
    Dataset = character(),
    Variable = character(),
    Description = character(),
    Unit = character(),
    stringsAsFactors = FALSE
)

# Helper to append rows
add_meta <- function(df, dataset, var, desc, unit) {
    rbind(df, data.frame(Dataset = dataset, Variable = var, Description = desc, Unit = unit))
}

# Pollen Deposition Metadata
data_dictionary <- data_dictionary %>%
    add_meta("pollen_deposition", "year", "Year of sampling", "Year (2022-2024)") %>%
    add_meta("pollen_deposition", "plot_id", "Unique identifier for the study plot", "Categorical") %>%
    add_meta("pollen_deposition", "inflorescence_id", "Unique identifier for the sampled inflorescence", "Categorical") %>%
    add_meta("pollen_deposition", "conspecific_pollen", "Count of conspecific (Succisa) pollen grains on stigma", "Count") %>%
    add_meta("pollen_deposition", "heterospecific_pollen", "Count of heterospecific (non-Succisa) pollen grains on stigma", "Count") %>%
    add_meta("pollen_deposition", "total_pollen", "Sum of conspecific and heterospecific pollen", "Count")

# SVD Metadata
data_dictionary <- data_dictionary %>%
    add_meta("SVD", "year", "Year of observation", "Year") %>%
    add_meta("SVD", "morphogroup", "Functional group of the visitor (e.g., Eristalis, Bombus)", "Categorical") %>%
    add_meta("SVD", "duration_sec", "Duration of the single visit", "Seconds") %>%
    add_meta("SVD", "conspecific_pollen", "Conspecific pollen deposited during single visit", "Count") %>%
    add_meta("SVD", "heterospecific_pollen", "Heterospecific pollen deposited during single visit", "Count")

# Network Metrics Metadata
data_dictionary <- data_dictionary %>%
    add_meta("network_metrics", "Year", "Year of sampling", "Year") %>%
    add_meta("network_metrics", "H2", "Network Specialization index (H2')", "Index [0-1]") %>%
    add_meta("network_metrics", "Evenness", "Interaction Evenness (Shannon's)", "Index [0-1]") %>%
    add_meta("network_metrics", "Slope", "Slope (Beta) of the CP-HP relationship (Type 1 dynamics)", "Coefficient") %>%
    add_meta("network_metrics", "Mean_HP", "Mean Heterospecific Pollen per stigma", "Count") %>%
    add_meta("network_metrics", "Succisa_Abundance", "Mean abundance of Succisa pratensis per plot", "Count / Patch") %>%
    add_meta("network_metrics", "Total_Abundance", "Total floral abundance in the community", "Count")


# --- 2. Export Data ---

# Create output directory if it doesn't exist
output_dir <- file.path("output", "publication_data")
if (!dir.exists(output_dir)) {
    dir.create(output_dir, recursive = TRUE)
}

# Export Dataframes
# Note using the dataframes available in the global environment from previous chunks

write.csv(pollen_deposition, file.path(output_dir, "pollen_deposition.csv"), row.names = FALSE)
# Use SVD_Succisa_22_24 which fits the description of SVD data
if (exists("SVD_Succisa_22_24")) {
    write.csv(SVD_Succisa_22_24, file.path(output_dir, "SVD.csv"), row.names = FALSE)
}
# Use final_table (unformatted) for metrics
if (exists("final_table")) {
    write.csv(final_table, file.path(output_dir, "network_metrics.csv"), row.names = FALSE)
}

# Export Metadata
write.csv(data_dictionary, file.path(output_dir, "data_dictionary.csv"), row.names = FALSE)
```

