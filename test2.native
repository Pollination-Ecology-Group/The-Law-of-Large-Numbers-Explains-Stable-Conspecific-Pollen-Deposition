Pandoc
  Meta { unMeta = fromList [] }
  [ Para
      [ Str "This"
      , Space
      , Str "is"
      , Space
      , Str "a"
      , Space
      , Str "paragraph"
      , Space
      , Str "referring"
      , Space
      , Str "to"
      , Space
      , Str "("
      , Link
          ( "" , [ "quarto-xref" ] , [] )
          [ Str "Figure" , Str "\160" , Str "1" ]
          ( "#fig-test" , "" )
      , Str ")."
      ]
  , Div
      ( "" , [ "cell" ] , [] )
      [ CodeBlock ( "" , [ "r" , "cell-code" ] , [] ) "plot(1)"
      , Div
          ( "" , [ "cell-output-display" ] , [] )
          [ Plain
              [ Image
                  ( "" , [] , [] )
                  []
                  ( "test2_files/figure-native/fig-test-1.png" , "" )
              ]
          ]
      ]
  ]
